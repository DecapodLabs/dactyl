# Explicit alternative for hosts where the release's workspace image is unavailable.
# This builds the published controller from crates.io; it does not publish an image.
FROM rust:1.96.1-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libsqlite3-0 python3 pkg-config
RUN cargo install decapod --version =0.143.0 --locked --root /opt/decapod --jobs 2
RUN rustup toolchain install 1.85.0 --profile minimal --component rustfmt,clippy && rustup component add rustfmt clippy --toolchain 1.96.1
RUN mkdir -p /opt/dactyl-proof-tools && ln -s /usr/bin/aarch64-linux-gnu-as /opt/dactyl-proof-tools/as && ln -s /usr/bin/aarch64-linux-gnu-ld.bfd /opt/dactyl-proof-tools/ld
RUN ln -s /bin/dash /opt/dactyl-proof-tools/sh
ENV PATH="/opt/decapod/bin:/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ENV DECAPOD_CONTAINER=1
COPY Cargo.toml Cargo.lock /opt/dactyl-proof-input/
COPY tools/proof/prepare.py /opt/dactyl-proof-input/prepare.py
# Dependency preparation only. Required builds/tests remain owned by validate.
RUN mkdir /opt/dactyl-proof-input/src && touch /opt/dactyl-proof-input/src/lib.rs
RUN cd /opt/dactyl-proof-input && DACTYL_STABLE_TOOLS=/usr/local/rustup/toolchains/1.96.1-aarch64-unknown-linux-gnu/bin python3 prepare.py
ARG PROOF_UID=0
ARG PROOF_GID=0
# CI runs as the checkout owner. Keep only its home and build/cache paths writable.
RUN mkdir -p /opt/dactyl-contract-target /opt/dactyl-proof-home && chown -R "${PROOF_UID}:${PROOF_GID}" /usr/local/cargo /opt/dactyl-contract-target /opt/dactyl-proof-home && chmod 700 /opt/dactyl-proof-home
