# This image describes the supported x86 native proof runtime. The native
# controller measures installed executable/runtime bytes in each invocation;
# neither this image tag nor successful image preparation is proof evidence.
FROM rust:1.96.1-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.11 gcc-12 binutils libc6-dev libsqlite3-0 ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

RUN rustup toolchain install 1.96.1 --profile minimal --component rustfmt --component clippy \
    && rustup toolchain install 1.75.0 --profile minimal --component rustfmt --component clippy \
    && test "$(uname -m)" = x86_64 \
    && test "$(readlink -f /usr/lib/x86_64-linux-gnu/libsqlite3.so.0)" = /usr/lib/x86_64-linux-gnu/libsqlite3.so.0.8.6 \
    && mkdir -p /opt/dactyl-proof-tools /opt/dactyl-contract-target \
    && ln -s /usr/bin/x86_64-linux-gnu-as /opt/dactyl-proof-tools/as \
    && ln -s /usr/bin/x86_64-linux-gnu-ld.bfd /opt/dactyl-proof-tools/ld \
    && ln -s /bin/dash /opt/dactyl-proof-tools/sh

ENV DACTYL_STABLE_TOOLS=/usr/local/rustup/toolchains/1.96.1-x86_64-unknown-linux-gnu/bin \
    DACTYL_MSRV_TOOLS=/usr/local/rustup/toolchains/1.75.0-x86_64-unknown-linux-gnu/bin \
    DACTYL_PROOF_TOOLS=/opt/dactyl-proof-tools \
    DACTYL_SQLITE_LIBRARY=/usr/lib/x86_64-linux-gnu/libsqlite3.so.0.8.6 \
    CARGO_BUILD_JOBS=2 \
    CARGO_HOME=/usr/local/cargo \
    CARGO_TARGET_DIR=/opt/dactyl-contract-target \
    RUSTUP_HOME=/usr/local/rustup \
    CC=/usr/bin/x86_64-linux-gnu-gcc-12 \
    AR=/usr/bin/x86_64-linux-gnu-ar \
    RUSTFLAGS="-C linker=/usr/bin/x86_64-linux-gnu-gcc-12"

# The job establishes a governed task/workspace, prepares dependencies through
# prepare.py and calls released Decapod. There is deliberately no proof CMD.
